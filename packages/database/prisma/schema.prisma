  reason            String?
  relatedPatientId  String?
  relatedTreatmentId String?
  createdAt         DateTime             @default(now())
  createdBy         String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
