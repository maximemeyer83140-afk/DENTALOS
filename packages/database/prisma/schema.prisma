// DentalOS Suisse — Initial data model (Phase 0)
//
// Design decisions (see /DATABASE.md for the full rationale):
// - Multi-tenant hierarchy: Organization -> Clinic -> {Users via UserClinicAccess, Practitioners,
//   Employees, Patients, ...}.
// - `organizationId` is stored as a denormalized, indexed column on every tenant-scoped table for
//   fast row-level tenant filtering. Referential integrity to Organization is enforced transitively
//   through the `clinicId -> Clinic -> Organization` relation and validated at the application/
//   repository layer (never trust a client-supplied organizationId alone).
// - Audit-only references (`createdBy`, `updatedBy`, `assignedToUserId`, `uploadedBy`, ...) are
//   plain indexed string columns holding a User id, WITHOUT a formal Prisma relation. This avoids a
//   50+ back-relation explosion on the User model while still being queryable and auditable. Real
//   business relations (Patient, Practitioner, Invoice, ...) use proper relations.
// - Money is stored as `Decimal @db.Decimal(12, 2)` (never Float). Top-level financial documents
//   (Invoice, Quote, Payment, CreditNote, Expense, ...) carry an explicit `currency`; line items
//   inherit the parent document's currency.
// - Table names are mapped to snake_case (`@@map`) for clean SQL; column names keep Prisma's
//   camelCase default (a common, low-maintenance convention).
// - This is the FOUNDATION for the full 90-section product brief, scoped to what Phases 0-2 need
//   structurally. Fields are intentionally lean (structure over completeness) — extend, don't
//   rebuild, in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE / TENANCY
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  defaultLocale Locale   @default(fr)
  defaultCurrency Currency @default(CHF)
  timezone      String   @default("Europe/Zurich")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinics Clinic[]
  users   User[]

  @@map("organizations")
}

model Clinic {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  addressLine1   String?
  addressLine2   String?
  npa            String?
  city           String?
  canton         String?
  country        String   @default("CH")
  phone          String?
  email          String?
  timezone       String   @default("Europe/Zurich")
  currency       Currency @default(CHF)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bankAccounts     BankAccount[]
  settings         ClinicSetting[]
  userAccess       UserClinicAccess[]
  practitioners    Practitioner[]
  employees        Employee[]
  patients         Patient[]
  rooms            Room[]
  appointmentTypes AppointmentType[]
  appointments     Appointment[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("clinics")
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String
  label          String
  iban           String
  qrIban         String?
  bic            String?
  bankName       String?
  currency       Currency @default(CHF)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@map("bank_accounts")
}

/// Free-form per-clinic configuration (appointment reminder delays, invoice numbering, feature
/// toggles, ...). Kept as a flexible key/value store instead of dozens of nullable columns.
model ClinicSetting {
  id        String   @id @default(cuid())
  clinicId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
  @@map("clinic_settings")
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  isEnabled      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// AUTH / RBAC
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String
  image          String?
  locale         Locale     @default(fr)
  status         UserStatus @default(active)
  mfaEnabled     Boolean    @default(false)
  /// TOTP secret. Phase 1 stores it in clear text — MUST be encrypted at rest before any real
  /// (non-fictitious) data is stored. Tracked as a known security debt, see SECURITY.md.
  mfaSecret      String?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicAccess UserClinicAccess[]
  accounts     Account[]
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

/// Auth.js standard schema (unused fields until an OAuth/SSO provider is added — kept now so
/// adding one later is a provider config change, not a migration).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Database-strategy session (not JWT): lets a compromised or offboarded user's session be
/// revoked immediately by deleting the row, which a stateless JWT cannot do without a separate
/// revocation list.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions  RolePermission[]
  clinicAccess UserClinicAccess[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Granular permission keys, e.g. "patients.read", "invoices.validate". Seeded, not user-editable.
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's role assignment within one specific clinic (a user may access several clinics with
/// different roles in each).
model UserClinicAccess {
  id        String   @id @default(cuid())
  userId    String
  clinicId  String
  roleId    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("user_clinic_access")
}

/// Append-only trail for sensitive operations. Never updated or deleted.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String?
  userId         String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PEOPLE
// ---------------------------------------------------------------------------

model Practitioner {
  id                 String             @id @default(cuid())
  organizationId     String
  clinicId           String
  userId             String?
  firstName          String
  lastName           String
  specialty          String?
  gln                String?
  professionalLicense String?
  color              String?
  status             PractitionerStatus @default(active)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  compensationRules  CompensationRule[]
  appointments       Appointment[]
  clinicalNotes      ClinicalNote[]
  treatmentPlans     TreatmentPlan[]
  treatmentPlanItems TreatmentPlanItem[]
  treatments         Treatment[]
  quotes             Quote[]
  invoices           Invoice[]
  prescriptions      Prescription[]

  @@unique([clinicId, firstName, lastName])
  @@index([organizationId])
  @@map("practitioners")
}

model Employee {
  id             String    @id @default(cuid())
  organizationId String
  clinicId       String
  userId         String?
  role           String
  contractType   String?
  activityRate   Decimal?  @db.Decimal(5, 2)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// PATIENTS
// ---------------------------------------------------------------------------

model Patient {
  id                 String           @id @default(cuid())
  organizationId     String
  clinicId           String
  patientNumber      String
  title              String?
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  sex                String?
  language            Locale?
  nationality        String?
  addressLine1       String?
  addressLine2       String?
  npa                String?
  city               String?
  canton             String?
  country            String?
  phone              String?
  mobile             String?
  email              String?
  legalGuardianName  String?
  referringPhysician String?
  referringDentist   String?
  acquisitionSource  AcquisitionSource @default(other)
  status             PatientStatus    @default(active)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdBy          String?

  clinic         Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  medicalProfile PatientMedicalProfile?
  medicalAlerts  MedicalAlert[]
  insurances     PatientInsurance[]
  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  dentalCharts   DentalChart[]
  periodontalCharts PeriodontalChart[]
  treatmentPlans TreatmentPlan[]
  treatments     Treatment[]
  quotes         Quote[]
  invoices       Invoice[]
  payments       Payment[]
  recalls        Recall[]
  communications Communication[]
  consents       Consent[]
  documents      Document[]
  labCases       LabCase[]
  prescriptions  Prescription[]

  @@unique([clinicId, patientNumber])
  @@index([organizationId])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

/// Structured, versioned medical questionnaire. A new version is written on every material change;
/// never overwritten silently (see MedicalProfileRevision).
/// ÉTAPE 4 : questionnaire médical structuré, pas un simple champ texte. `pathologies` is a
/// `{ [code]: { present: boolean, notes?: string } }` object keyed by the fixed 13-item list in
/// apps/web/src/lib/anamnese.ts (PATHOLOGY_DEFS) — kept as Json rather than one column per
/// pathology so the list can grow without a migration each time. `medications` is a
/// `{ name, dose?, frequency?, comment? }[]` array, replacing the old flat string list.
model PatientMedicalProfile {
  id                String   @id @default(cuid())
  patientId         String   @unique
  pathologies       Json     @default("{}")
  medications       Json     @default("[]")
  allergies         String[]
  isPregnant        Boolean?
  isSmoker          Boolean?
  alcoholUse        Boolean?
  onAnticoagulants  Boolean?
  onAntiplatelets   Boolean?
  pastSurgeries     String[]
  treatingPhysician String?
  riskNotes         String?
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  patient   Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  revisions PatientMedicalProfileRevision[]

  @@map("patient_medical_profiles")
}

model PatientMedicalProfileRevision {
  id           String   @id @default(cuid())
  profileId    String
  snapshot     Json
  version      Int
  recordedAt   DateTime @default(now())
  recordedBy   String?

  profile PatientMedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("patient_medical_profile_revisions")
}

/// Denormalized, always-visible banner alerts (allergy, anticoagulants, ...) surfaced immediately
/// on the patient record, independent of the full medical profile.
model MedicalAlert {
  id        String            @id @default(cuid())
  patientId String
  type      MedicalAlertType
  label     String
  severity  MedicalAlertSeverity @default(warning)
  isActive  Boolean           @default(true)
  /// Set only on alerts the system derives automatically from the anamnèse (allergy,
  /// anticoagulant, antiplatelet, pregnancy — see medical-alerts.ts's syncDerivedAlerts). Null for
  /// alerts a user added manually via AlertForm; syncing only ever touches alerts carrying a key it
  /// recognizes, so it can never clobber a manual entry.
  sourceKey String?
  createdAt DateTime          @default(now())
  createdBy String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, sourceKey])
  @@map("medical_alerts")
}

model Payer {
  id             String    @id @default(cuid())
  organizationId String
  type           PayerType
  name           String
  contactInfo    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  insurances PatientInsurance[]
  invoices   Invoice[]
  payments   Payment[]

  @@index([organizationId])
  @@map("payers")
}

model PatientInsurance {
  id             String    @id @default(cuid())
  patientId      String
  payerId        String
  policyNumber   String?
  insuredNumber  String?
  coverageType   InsuranceCoverageType @default(other)
  validFrom      DateTime?
  validTo        DateTime?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer   Payer   @relation(fields: [payerId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_insurances")
}

// ---------------------------------------------------------------------------
// AGENDA
// ---------------------------------------------------------------------------

model Room {
  id       String  @id @default(cuid())
  clinicId String
  name     String
  isActive Boolean @default(true)

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@map("rooms")
}

model AppointmentType {
  id                    String   @id @default(cuid())
  clinicId              String
  name                  String
  defaultDurationMinutes Int
  color                 String?
  instructions          String?
  defaultPrice          Decimal? @db.Decimal(12, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@map("appointment_types")
}

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  clinicId          String
  patientId         String?
  practitionerId    String
  roomId            String?
  appointmentTypeId String?
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(scheduled)
  notes             String?
  source            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  practitioner    Practitioner     @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  room            Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  appointmentType AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)

  clinicalNotes     ClinicalNote[]
  treatments        Treatment[]
  waitingListEntries WaitingListEntry[]

  @@index([organizationId])
  @@index([clinicId, startAt])
  @@index([practitionerId, startAt])
  @@index([roomId, startAt])
  @@map("appointments")
}

/// Un patient en liste d'attente a déjà un rendez-vous fixé (`appointmentId`, obligatoire) et
/// souhaite une place plus tôt si un autre patient annule — ce n'est jamais un vœu libre
/// ("je veux un rendez-vous de tel type"), donc pas de appointmentTypeId/praticien/durée
/// indépendants : ces informations se lisent sur `appointment` lui-même.
model WaitingListEntry {
  id                String             @id @default(cuid())
  organizationId    String
  clinicId          String
  patientId         String
  appointmentId     String
  urgency           WaitingListUrgency @default(normal)
  availabilityNotes String?
  status            WaitingListStatus  @default(waiting)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([appointmentId])
  @@map("waiting_list_entries")
}

// ---------------------------------------------------------------------------
// CLINICAL
// ---------------------------------------------------------------------------

model ClinicalNote {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String
  patientId      String
  practitionerId String
  appointmentId  String?
  noteType       String   @default("consultation")
  content        String
  isFinalized    Boolean  @default(false)
  finalizedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  revisions    ClinicalNoteRevision[]

  @@index([organizationId])
  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

/// A finalized note is never overwritten in place: corrections are appended here and the note
/// keeps pointing at its latest content, preserving the full editing history.
model ClinicalNoteRevision {
  id             String   @id @default(cuid())
  clinicalNoteId String
  content        String
  reason         String?
  editedAt       DateTime @default(now())
  editedBy       String?

  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)

  @@index([clinicalNoteId])
  @@map("clinical_note_revisions")
}

/// Ordonnance — rédigée depuis la fiche clinique du patient. `documentId` reste un lien optionnel
/// vers un vrai fichier numérisé/imprimé (voir Consent.documentId pour le même principe) : rien
/// n'oblige à en avoir un, une ordonnance existe d'abord comme donnée structurée.
model Prescription {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String
  patientId      String
  practitionerId String
  notes          String?
  documentId     String?
  createdAt      DateTime @default(now())
  createdBy      String?

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner       @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@index([organizationId])
  @@index([patientId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  medication     String
  dosage         String
  duration       String

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// One snapshot of the full-mouth dental chart as of a given date (FDI numbering). Historical
/// snapshots are kept so the chart can be viewed as of any prior date.
model DentalChart {
  id        String   @id @default(cuid())
  patientId String
  asOfDate  DateTime @default(now())
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  patient Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entries DentalChartEntry[]

  @@index([patientId, asOfDate])
  @@map("dental_charts")
}

model DentalChartEntry {
  id            String  @id @default(cuid())
  dentalChartId String
  toothNumber   Int
  surface       String?
  condition     DentalConditionType
  notes         String?

  dentalChart DentalChart @relation(fields: [dentalChartId], references: [id], onDelete: Cascade)

  @@index([dentalChartId, toothNumber])
  @@map("dental_chart_entries")
}

model PeriodontalChart {
  id             String   @id @default(cuid())
  patientId      String
  practitionerId String
  examDate       DateTime @default(now())
  createdAt      DateTime @default(now())

  patient      Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  measurements PeriodontalMeasurement[]

  @@index([patientId, examDate])
  @@map("periodontal_charts")
}

model PeriodontalMeasurement {
  id                 String  @id @default(cuid())
  periodontalChartId String
  toothNumber        Int
  site               String
  probingDepthMm      Int?
  recessionMm         Int?
  bleeding           Boolean @default(false)
  plaque             Boolean @default(false)
  mobility           Int?
  furcation          Int?

  periodontalChart PeriodontalChart @relation(fields: [periodontalChartId], references: [id], onDelete: Cascade)

  @@index([periodontalChartId, toothNumber])
  @@map("periodontal_measurements")
}

model TreatmentPlan {
  id             String            @id @default(cuid())
  organizationId String
  clinicId       String
  patientId      String
  practitionerId String
  title          String?
  status         TreatmentPlanStatus @default(draft)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?

  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner Practitioner          @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  options      TreatmentPlanOption[]

  @@index([organizationId])
  @@index([patientId])
  @@map("treatment_plans")
}

/// A plan may offer several mutually-exclusive scenarios ("Option A: implant", "Option B: bridge").
model TreatmentPlanOption {
  id              String  @id @default(cuid())
  treatmentPlanId String
  label           String
  description     String?
  isSelected      Boolean @default(false)

  treatmentPlan TreatmentPlan          @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  items         TreatmentPlanItem[]

  @@index([treatmentPlanId])
  @@map("treatment_plan_options")
}

model TreatmentPlanItem {
  id                     String   @id @default(cuid())
  treatmentPlanOptionId  String
  tariffItemId           String?
  practitionerId         String?
  toothNumber            Int?
  description            String
  quantity               Int      @default(1)
  unitPrice              Decimal  @db.Decimal(12, 2)
  sequence               Int      @default(0)
  sessionNumber          Int?
  status                 TreatmentPlanItemStatus @default(planned)

  treatmentPlanOption TreatmentPlanOption @relation(fields: [treatmentPlanOptionId], references: [id], onDelete: Cascade)
  tariffItem          TariffItem?         @relation(fields: [tariffItemId], references: [id], onDelete: SetNull)
  practitioner        Practitioner?       @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  treatments          Treatment[]
  quoteItems          QuoteItem[]

  @@index([treatmentPlanOptionId])
  @@map("treatment_plan_items")
}

/// An actually performed clinical act (as opposed to a planned TreatmentPlanItem).
model Treatment {
  id                  String   @id @default(cuid())
  organizationId      String
  clinicId            String
  patientId           String
  practitionerId      String
  treatmentPlanItemId String?
  appointmentId       String?
  tariffItemId        String?
  toothNumber         Int?
  description         String
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(12, 2)
  performedAt         DateTime @default(now())
  status              TreatmentStatus @default(completed)
  createdAt           DateTime @default(now())
  createdBy           String?

  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner      Practitioner       @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatmentPlanItem TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id], onDelete: SetNull)
  tariffItem        TariffItem?        @relation(fields: [tariffItemId], references: [id], onDelete: SetNull)
  invoiceItems      InvoiceItem[]

  @@index([organizationId])
  @@index([patientId])
  @@index([practitionerId, performedAt])
  @@map("treatments")
}

// ---------------------------------------------------------------------------
// QUOTES
// ---------------------------------------------------------------------------

model Quote {
  id              String      @id @default(cuid())
  organizationId  String
  clinicId        String
  patientId       String
  practitionerId  String
  treatmentPlanId String?
  quoteNumber     String
  status          QuoteStatus @default(draft)
  validUntil      DateTime?
  subtotal        Decimal     @db.Decimal(12, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        Currency    @default(CHF)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  items        QuoteItem[]

  @@unique([clinicId, quoteNumber])
  @@index([organizationId])
  @@index([patientId])
  @@map("quotes")
}

model QuoteItem {
  id                    String  @id @default(cuid())
  quoteId               String
  description           String
  tariffItemId          String?
  /// Traces this line back to the TreatmentPlanItem it was copied from (ÉTAPE 6) — without it,
  /// nothing links a quoted/invoiced line back to the planned act it billed, which is exactly the
  /// "duplication incohérente entre traitement, facture et paiement" the brief warns against.
  treatmentPlanItemId   String?
  toothNumber           Int?
  quantity              Int     @default(1)
  unitPrice             Decimal @db.Decimal(12, 2)
  lineTotal             Decimal @db.Decimal(12, 2)

  quote             Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tariffItem        TariffItem?        @relation(fields: [tariffItemId], references: [id], onDelete: SetNull)
  treatmentPlanItem TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([treatmentPlanItemId])
  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// SWISS TARIFF ENGINE — never hardcode tariffs in business logic; model them as versioned data.
// ---------------------------------------------------------------------------

model TariffCatalog {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  system         String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions TariffVersion[]

  @@index([organizationId])
  @@map("tariff_catalogs")
}

model TariffVersion {
  id              String   @id @default(cuid())
  tariffCatalogId String
  versionLabel    String
  validFrom       DateTime
  validTo         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  catalog TariffCatalog @relation(fields: [tariffCatalogId], references: [id], onDelete: Cascade)
  items   TariffItem[]
  rules   TariffRule[]

  @@index([tariffCatalogId])
  @@map("tariff_versions")
}

/// Swiss dental tariffs price a position two ways at once: a fixed point count for social-insurance
/// billing (AA/AM/AI — `points`), and, for private patients under SSO's DENTOTAR®, a point RANGE the
/// practitioner picks within depending on case complexity (`pointsPrivateMin`/`pointsPrivateMax`).
/// Either way the point value itself (CHF per point) is never stored per item — it's a clinic/session
/// setting (capped at CHF 1.70 for SSO members on DENTOTAR, fixed nationally at CHF 1.00 for AA/AM/AI
/// since 1 January 2018), applied at pricing time by `services/tariff-pricing.ts`, never here.
model TariffItem {
  id                   String   @id @default(cuid())
  tariffVersionId      String
  code                 String
  description          String
  category             String?
  points               Decimal? @db.Decimal(10, 3)
  pointsPrivateMin     Decimal? @db.Decimal(10, 3)
  pointsPrivateMax     Decimal? @db.Decimal(10, 3)
  pointValue           Decimal? @db.Decimal(10, 4)
  defaultQuantity      Int      @default(1)
  manualPriceAllowed   Boolean  @default(false)
  computedPrice        Decimal? @db.Decimal(12, 2)

  tariffVersion       TariffVersion         @relation(fields: [tariffVersionId], references: [id], onDelete: Cascade)
  treatmentPlanItems  TreatmentPlanItem[]
  treatments          Treatment[]
  quoteItems          QuoteItem[]
  invoiceItems        InvoiceItem[]

  @@unique([tariffVersionId, code])
  @@map("tariff_items")
}

model TariffRule {
  id              String  @id @default(cuid())
  tariffVersionId String
  ruleType        String
  config          Json
  description     String?

  tariffVersion TariffVersion @relation(fields: [tariffVersionId], references: [id], onDelete: Cascade)

  @@index([tariffVersionId])
  @@map("tariff_rules")
}

// ---------------------------------------------------------------------------
// BILLING
// ---------------------------------------------------------------------------

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clinicId       String
  patientId      String
  payerId        String?
  practitionerId String
  invoiceNumber  String
  status         InvoiceStatus @default(draft)
  issueDate      DateTime?
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  balance        Decimal       @db.Decimal(12, 2)
  currency       Currency      @default(CHF)
  validatedAt    DateTime?
  validatedBy    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  payer        Payer?       @relation(fields: [payerId], references: [id], onDelete: SetNull)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  items              InvoiceItem[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]
  reminders          PaymentReminder[]

  @@unique([clinicId, invoiceNumber])
  @@index([organizationId])
  @@index([clinicId, status])
  @@index([patientId])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  tariffItemId String?
  treatmentId  String?
  toothNumber  Int?
  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tariffItem TariffItem? @relation(fields: [tariffItemId], references: [id], onDelete: SetNull)
  treatment  Treatment?  @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model CreditNote {
  id             String   @id @default(cuid())
  organizationId String
  clinicId       String
  invoiceId      String
  creditNoteNumber String
  reason         String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       Currency @default(CHF)
  issueDate      DateTime @default(now())
  createdAt      DateTime @default(now())
  createdBy      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([clinicId, creditNoteNumber])
  @@index([invoiceId])
  @@map("credit_notes")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  clinicId       String
  patientId      String
  payerId        String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       Currency      @default(CHF)
  method         PaymentMethod
  status         PaymentStatus @default(completed)
  reference      String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  createdBy      String?

  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  payer       Payer?              @relation(fields: [payerId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@index([organizationId])
  @@index([clinicId, paidAt])
  @@index([patientId])
  @@map("payments")
}

/// A single payment can be split across several invoices (or an invoice paid via several
/// payments); this join table is the source of truth for `Invoice.amountPaid`.
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model PaymentReminder {
  id           String        @id @default(cuid())
  invoiceId    String
  level        ReminderLevel
  fee          Decimal?      @db.Decimal(12, 2)
  interest     Decimal?      @db.Decimal(12, 2)
  documentUrl  String?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  createdBy    String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment_reminders")
}

